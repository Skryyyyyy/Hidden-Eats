# Supabase Configuration (Shared across web & mobile)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Maps API Keys
# SERVER KEY: Used ONLY by Supabase Edge Functions (Places API New, Details, Photos). Never exposed to clients.
GOOGLE_MAPS_SERVER_KEY=your-google-maps-server-key

# CLIENT KEY: Embedded in mobile app (react-native-maps tile rendering ONLY). Restricted to package name / bundle ID.
GOOGLE_MAPS_CLIENT_KEY=your-google-maps-client-key
